#!/bin/bash
export SAVE_MY_DIR=`pwd`
export BUILD_STAMP="2.13.42-alpha17-202611152200"

if [ "$1" == "reset" ]
then
    unset dtm
    unset dt_tens
    unset dt_ones
    unset curdate
    unset logroot
fi
if [ "$curdate" == "" ]
then
    export dtm=`date +%M`
    export dt_tens=${dtm:0:1}
    export dt_ones=${dtm:1:1}
    export dtintro=`date +%Y%m%d%H`
    if [ "$dt_ones" == "0" ]
    then
        export curdate="${dtintro}${dt_tens}0"
    elif [ "$dt_ones" == "1" ]
    then
        export curdate="${dtintro}${dt_tens}0"
    elif [ "$dt_ones" == "2" ]
    then
        export curdate="${dtintro}${dt_tens}0"
    elif [ "$dt_ones" == "3" ]
    then
        export curdate="${dtintro}${dt_tens}0"
    elif [ "$dt_ones" == "4" ]
    then
        export curdate=${dtintro}${dt_tens}0
    else
        export curdate=${dtintro}${dt_tens}5
    fi
fi

# Determine run state
if [ "$BUILD_STAMP" == "" ]
then
	export DO_RESET=Y
elif [ "$1" == "reset" ]
then
	export DO_RESET=Y
fi
if [ "$DO_RESET" == "Y" ]
then
	export BUILD_STAMP=$curdate
fi
cd $SAVE_MY_DIR
